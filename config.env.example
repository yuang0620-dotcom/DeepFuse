# Copy to config.env and fill in. Only `./run.sh check`, `all` and `splits` need these.
PANDERM_CODE=/path/to/PanDerm            # git clone https://github.com/SiyuanYan1/PanDerm
PANDERM_CKPT=/path/to/panderm_ll_data6_checkpoint-499.pth
DEEPFUSE_DATA=/path/to/data              # dataset images, see README "Dataset layout"
LIBFEWSHOT=/path/to/LibFewShot           # git clone https://github.com/RL-VIG/LibFewShot
ISIC_META=/path/to/isic_archive/metadata.csv   # only for ./run.sh splits
# PYTHON=python                          # interpreter with requirements.txt installed
